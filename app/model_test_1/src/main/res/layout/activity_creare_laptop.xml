<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreareLaptopActivity">

    <LinearLayout
        android:layout_width="351dp"
        android:layout_height="657dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/bucur_andrei_textViewId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/id" />

        <EditText
            android:id="@+id/bucur_andrei_editTextId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:text="@string/ex_67" />

        <TextView
            android:id="@+id/bucur_andrei_textViewPret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pret" />

        <EditText
            android:id="@+id/bucur_andrei_editTextPret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:text="@string/ex_12_3" />

        <Switch
            android:id="@+id/bucur_andrei_switch1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ESTE SH?" />

        <RadioGroup
            android:id="@+id/andrei_bucur_radioGroup"
            android:layout_width="match_parent"
            android:layout_height="165dp">

            <TextView
                android:id="@+id/bucur_andrei_textMarca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/marca" />

            <RadioButton
                android:id="@+id/bucur_andrei_radioLenovo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lenovo" />

            <RadioButton
                android:id="@+id/bucur_andrei_radioAsus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/asus" />

            <RadioButton
                android:id="@+id/bucur_andrei_radioHp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hp" />
        </RadioGroup>

        <Button
            android:id="@+id/bucur_andrei_buttonSalvare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/creaza" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreareBicicletaActivity">

    <LinearLayout
        android:layout_width="308dp"
        android:layout_height="640dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.494">

        <EditText
            android:id="@+id/andreiBucurEtId"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:ems="10"
            android:inputType="text"
            android:text="Name" />

        <EditText
            android:id="@+id/andreiBucurEtPret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:text="Name" />

        <RadioGroup
            android:id="@+id/andreiBucurRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="102dp" >

            <RadioButton
                android:id="@+id/andreiBucurRadioBtnMTB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MTB" />

            <RadioButton
                android:id="@+id/andreiBucurRadioBtnLala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lala" />
        </RadioGroup>

        <Spinner
            android:id="@+id/andreiBucurSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/tari" />

        <Button
            android:id="@+id/andreiBucurAdaugaBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Button" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreareCutieActivity">

    <LinearLayout
        android:layout_width="305dp"
        android:layout_height="607dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/andreiBucurEditTextText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:text="@string/cod" />

        <EditText
            android:id="@+id/andreiBucurEditTextText2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:text="@string/culoara" />

        <EditText
            android:id="@+id/andreiBucurEditTextText3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
    />

        <Switch
            android:id="@+id/andreiBucurSwitch1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/premium" />

        <RatingBar
            android:id="@+id/andreiBucurRatingBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/andreiBucurButtonSalveaza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/salveaza" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>